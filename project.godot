; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RL"
config/description="Single-player extraction shooter. Post-apocalyptic, esoteric, alchemical."
run/main_scene="res://boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Events="*res://autoload/events.gd"
Settings="*res://autoload/settings.gd"
Registry="*res://autoload/registry.gd"
Audio="*res://autoload/audio.gd"
Ballistics="*res://autoload/ballistics.gd"
Effects="*res://autoload/effects.gd"
UI="*res://ui/ui.tscn"
Game="*res://autoload/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="npc"
3d_physics/layer_4="hitbox"
3d_physics/layer_5="interact"
3d_physics/layer_6="debris"
3d_physics/layer_7="trigger"
3d_physics/layer_8="clip"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/compress_with_gpu=false
textures/default_filters/anisotropic_filtering_level=4
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
limits/cluster_builder/max_clustered_elements=1024
anti_aliasing/quality/use_taa=true
occlusion_culling/use_occlusion_culling=true
